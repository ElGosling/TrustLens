# Copy this file to .env, fill in the values, and never commit it.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Add this before enabling trusted-source web fact checking.
TAVILY_API_KEY=

# Where the local SQLite database of checks and quiz results is written.
TRUSTLENS_DB_PATH=data/trustlens.sqlite3
# How many questions one /quiz asks (1-10).
TRUSTLENS_QUIZ_QUESTIONS=5
